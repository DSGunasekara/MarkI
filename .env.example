# Shared local development defaults
# Copy values into the app-specific .env files as needed.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hiring_engine
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=4173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiring_engine
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4173,http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=hiring-engine
GITHUB_APP_PRIVATE_KEY_BASE64=replace-with-single-line-base64-private-key
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\\nREPLACE_ME\\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET=replace-with-a-github-app-webhook-secret
GITHUB_WEBHOOK_SECRET=replace-with-a-github-webhook-secret
PIPELINE_DEPLOYMENT_MODE=docker
PIPELINE_PREVIEW_EXPOSURE_MODE=port
PIPELINE_PREVIEW_BASE_URL=http://localhost
PIPELINE_PREVIEW_BASE_DOMAIN=preview.example.com
PIPELINE_PREVIEW_DOCKER_NETWORK=
PIPELINE_PREVIEW_TRAEFIK_ENTRYPOINTS=websecure
PIPELINE_PREVIEW_PORT_MIN=4500
PIPELINE_PREVIEW_PORT_MAX=5500
PIPELINE_DEPLOYMENT_BASE_URL=http://localhost:4173
PIPELINE_COMMAND_TIMEOUT_MS=600000
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
VITE_API_BASE_URL=http://localhost:3000
